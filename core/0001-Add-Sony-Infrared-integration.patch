+"""Tests for the Sony Infrared media player platform."""
+
+from infrared_protocols.codes.sony.tv import (
+    SONY_TV_ADDRESS,
+    SONY_TV_ADDRESS_BITS,
+    SonyTVCode,
+)
+from infrared_protocols.commands.sony import SonyCommand
+import pytest
+from pytest_homeassistant.common import MockConfigEntry, snapshot_platform
+from pytest_homeassistant.components.common import (
+    assert_availability_follows_source_entity,
+)
+from pytest_homeassistant.components.infrared import EMITTER_ENTITY_ID
+from pytest_homeassistant.components.infrared.common import MockInfraredEmitterEntity
+from syrupy.assertion import SnapshotAssertion
+
+from homeassistant.components.media_player import (
+    DOMAIN as MEDIA_PLAYER_DOMAIN,
+    SERVICE_MEDIA_NEXT_TRACK,
+    SERVICE_MEDIA_PREVIOUS_TRACK,
+    SERVICE_TURN_OFF,
+    SERVICE_TURN_ON,
+    SERVICE_VOLUME_DOWN,
+    SERVICE_VOLUME_MUTE,
+    SERVICE_VOLUME_UP,
+)
+from homeassistant.const import ATTR_ENTITY_ID
+from homeassistant.core import HomeAssistant
+from homeassistant.helpers import device_registry as dr, entity_registry as er
+
+MEDIA_PLAYER_ENTITY_ID = "media_player.sony_tv"
+
+
+@pytest.mark.usefixtures("init_integration")
+async def test_entities(
+    hass: HomeAssistant,
+    snapshot: SnapshotAssertion,
+    entity_registry: er.EntityRegistry,
+    device_registry: dr.DeviceRegistry,
+    mock_config_entry: MockConfigEntry,
+) -> None:
+    """Test the media player entity is created with the expected attributes."""
+    await snapshot_platform(hass, entity_registry, snapshot, mock_config_entry.entry_id)
+
+    device_entry = device_registry.async_get_device_by_identifier(
+        ("sony_infrared", mock_config_entry.entry_id), mock_config_entry.entry_id
+    )
+    assert device_entry
+    assert device_entry.manufacturer == "Sony"
+
+
+@pytest.mark.parametrize(
+    ("service", "service_data", "expected_code"),
+    [
+        (SERVICE_TURN_ON, {}, SonyTVCode.POWER),
+        (SERVICE_TURN_OFF, {}, SonyTVCode.POWER),
+        (SERVICE_VOLUME_UP, {}, SonyTVCode.VOLUME_UP),
+        (SERVICE_VOLUME_DOWN, {}, SonyTVCode.VOLUME_DOWN),
+        (SERVICE_VOLUME_MUTE, {"is_volume_muted": True}, SonyTVCode.MUTE),
+        (SERVICE_MEDIA_NEXT_TRACK, {}, SonyTVCode.CHANNEL_UP),
+        (SERVICE_MEDIA_PREVIOUS_TRACK, {}, SonyTVCode.CHANNEL_DOWN),
+    ],
+)
+@pytest.mark.usefixtures("init_integration")
+async def test_media_player_action_sends_correct_code(
+    hass: HomeAssistant,
+    mock_infrared_emitter_entity: MockInfraredEmitterEntity,
+    service: str,
+    service_data: dict[str, bool],
+    expected_code: SonyTVCode,
+) -> None:
+    """Test each media player action sends a three-frame key press."""
+    await hass.services.async_call(
+        MEDIA_PLAYER_DOMAIN,
+        service,
+        {ATTR_ENTITY_ID: MEDIA_PLAYER_ENTITY_ID, **service_data},
+        blocking=True,
+    )
+
+    assert len(mock_infrared_emitter_entity.send_command_calls) == 1
+    command = mock_infrared_emitter_entity.send_command_calls[0]
+    assert isinstance(command, SonyCommand)
+    assert command.address == SONY_TV_ADDRESS
+    assert command.address_bits == SONY_TV_ADDRESS_BITS
+    assert command.command == expected_code
+    assert command.repeat_count == 2
+
+
+@pytest.mark.usefixtures("init_integration")
+async def test_media_player_availability_follows_ir_entity(
+    hass: HomeAssistant,
+) -> None:
+    """Test the media player becomes unavailable when the emitter is unavailable."""
+    await assert_availability_follows_source_entity(
+        hass, MEDIA_PLAYER_ENTITY_ID, [EMITTER_ENTITY_ID]
+    )
